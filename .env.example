# =============================================================================
# UnityTools V2 - .env example
# =============================================================================
# Bu dosyayi .env olarak kopyalayip kendi degerlerinizle doldurun.

# --- LLM Provider Secimi ---------------------------------------------------
# 'anthropic'  = Claude (Cloud, en iyi tool-calling kalitesi, API key gerekir)
# 'ollama'     = Local Ollama sunucusu (offline, ucretsiz; iyi modelle calisir)
# 'cloudflare' = Cloudflare Workers AI (Cloud, GPU YOK gerektirmez; 70B Llama)
UNITYTOOLS_PROVIDER=ollama

# --- Anthropic API ---------------------------------------------------------
# https://console.anthropic.com adresinden al
ANTHROPIC_API_KEY=

# Hangi Claude modeli? Tool-calling icin hepsi iyidir.
#   claude-sonnet-4-20250514   <- DENGELI (onerilen)
#   claude-opus-4-1-20250805   <- en akilli, yavas/pahali
#   claude-3-5-haiku-20241022  <- hizli/ucuz, basit gorevler icin
UNITYTOOLS_MODEL=claude-sonnet-4-20250514

# --- Ollama (yerel) --------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# DIKKAT: Tool-calling kucuk modellerle (1B-4B) GUVENILIR DEGILDIR.
# Onerilen modeller / Recommended models:
#   qwen2.5:14b-instruct      <- KULLANDIGIMIZ / recommended default
#   qwen2.5:7b-instruct       <- daha hafif / lighter fallback
#   llama3.1:8b               <- alternatif / alternative
#   mistral-nemo:12b          <- alternatif / alternative
OLLAMA_MODEL=qwen2.5:14b-instruct

# --- Cloudflare Workers AI (yerel GPU YOK, 70B model) ----------------------
# Yerel PC'de GPU yoksa en pratik secenek: 70B Llama'yi Cloudflare'in
# altyapisinda calistir. Adimlar:
#   1. dash.cloudflare.com > sag ust > Account ID'yi kopyala
#   2. dash.cloudflare.com/profile/api-tokens > Create Token >
#      "Workers AI" template (veya Account > Workers AI > Read+Run yetkisi)
# UNITYTOOLS_PROVIDER=cloudflare yaptiginda bu degerler kullanilir.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Tool-calling destekli, hizli 70B (onerilen varsayilan):
#   @cf/meta/llama-3.3-70b-instruct-fp8-fast   <- ONERILEN (hizli 70B)
#   @cf/meta/llama-3.1-70b-instruct            <- alternatif
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Opsiyonel: AI Gateway veya ozel endpoint kullaniyorsan tam /v1 tabani.
# Bos birakirsan account id'den otomatik kurulur.
# CLOUDFLARE_BASE_URL=

# --- Optional dual-agent mode ---------------------------------------------
# Unity/Unreal embedded panels start dual-agent by default.
# Reader/Worker use Qwen 2.5 for fast scene/asset reading and tool execution.
# Master uses Qwen 3.6 for deeper planning; CLI falls back if it is not installed.
USE_DUAL_AGENT=true
DUAL_AGENT_READER=qwen2.5:14b-instruct
DUAL_AGENT_MASTER=qwen3.6:latest
DUAL_AGENT_WORKER=qwen2.5:14b-instruct

# --- LLM uretim parametreleri ----------------------------------------------
# Anthropic max_tokens (varsayilan 8192). Kompleks gorevlerde 16384'e cikarin.
UNITYTOOLS_MAX_TOKENS=8192

# Sohbet gecmisi: en fazla kac mesaj/turn tutulsun (token sismesini engeller)
UNITYTOOLS_HISTORY_LIMIT=40

# --- Guvenlik / Auth -------------------------------------------------------
# Kopru (Unity/Unreal) ve chat-server, ayni makinedeki baglantilari paylasilan
# bir token ile dogrular. Token cozum sirasi:
#   UNITYTOOLS_BRIDGE_TOKEN  ->  UNITYTOOLS_SECRET  ->  UNITYTOOLS_KEY
# Token BOS ise kimlik dogrulama KAPALIDIR (yalnizca loopback baglantilari korur).
# ONERI: rastgele, uzun bir deger kullan. Ayni degerin hem Python tarafinda hem de
# editor (Unity/Unreal) tarafinda gorunmesi icin bunu bir KULLANICI ortam
# degiskeni olarak ayarlamak en kolayidir (UNITYTOOLS_BRIDGE_TOKEN).
UNITYTOOLS_BRIDGE_TOKEN=
# UNITYTOOLS_KEY / UNITYTOOLS_SECRET de token kaynagi olarak kabul edilir.

# Loopback disi (LAN) dinlemeye yalnizca bilerek izin ver. Acmak icin 1 yap;
# bu durumda mutlaka bir token de ayarli olmali (aksi halde reddedilir).
UNITYTOOLS_ALLOW_REMOTE=0

# Unity ExecuteMenuItem koprusu icin izinli menu onekleri (varsayilan:
# "GameObject/" ve "Component/"). Ek onekleri noktali-virgulle ekle.
# Ornek: UNITYTOOLS_MENU_ALLOW=Assets/Create/;Window/
UNITYTOOLS_MENU_ALLOW=

# Unreal import_asset icin izinli ek kaynak kok (proje klasoru her zaman izinli).
# UNREALTOOLS_IMPORT_ROOT=D:\Assets\Incoming

# Unreal panelinin baslatacagi Python yorumlayicisi (PATH yerine mutlak yol).
# UNITYTOOLS_PYTHON=C:\Path\to\python.exe

# --- Unity Editor Bridge ---------------------------------------------------
UNITY_BRIDGE_PORT=7777
UNITY_BRIDGE_HOST=127.0.0.1
UNITY_RPC_TIMEOUT=180

# --- Unreal Editor Bridge --------------------------------------------------
# UnrealToolsBridge listens on this port inside Unreal Editor.
UNREAL_BRIDGE_PORT=8777
UNREAL_BRIDGE_HOST=127.0.0.1
UNREAL_RPC_TIMEOUT=180
# Optional; empty means auto-detect UE_*/UnrealEditor.exe.
UNREAL_EXECUTABLE=

# --- Blender ---------------------------------------------------------------
# Bos birakirsaniz PATH'ten ve standart kurulum konumlarindan otomatik aranir.
# Windows ornegi: BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
BLENDER_EXECUTABLE=

# --- Unity executable (batch mode icin, opsiyonel) -------------------------
# UNITY_EXECUTABLE=C:\Program Files\Unity\Hub\Editor\6000.0.30f1\Editor\Unity.exe

# --- Logging --------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


