# =============================================================================
# UnityTools V2 - .env example
# =============================================================================
# Bu dosyayi .env olarak kopyalayip kendi degerlerinizle doldurun.

# --- LLM Provider Secimi ---------------------------------------------------
# 'anthropic' = Claude (Cloud, en iyi tool-calling kalitesi, API key gerekir)
# 'ollama'    = Local Ollama sunucusu (offline, ucretsiz; iyi modelle calisir)
UNITYTOOLS_PROVIDER=ollama

# --- Anthropic API ---------------------------------------------------------
# https://console.anthropic.com adresinden al
ANTHROPIC_API_KEY=

# Hangi Claude modeli? Tool-calling icin hepsi iyidir.
#   claude-sonnet-4-20250514   <- DENGELI (onerilen)
#   claude-opus-4-1-20250805   <- en akilli, yavas/pahali
#   claude-3-5-haiku-20241022  <- hizli/ucuz, basit gorevler icin
UNITYTOOLS_MODEL=claude-sonnet-4-20250514

# --- Ollama (yerel) --------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Phase 57: gemma4:latest is the studio's default local model. It
# handles all 23 studio role allowlists + the 30-entry Behaviour
# Library tool-call patterns reliably. Override per-call with the
# --model flag if you need a heavier model for a specific run.
#
# Other supported models (all tool-calling capable):
#   gemma4:latest             <- DEFAULT / recommended
#   qwen2.5:14b-instruct      <- 14B alternative
#   qwen2.5:7b-instruct       <- lighter fallback
#   llama3.1:8b               <- alternative
#   mistral-nemo:12b          <- alternative
# AVOID for tool-calling: qwen3:1b, llama3.2:1b, llama3.2:3b,
# phi3:mini, gemma:2b — too small to reliably emit structured calls.
#
# Per-call override examples:
#   unitytools studio-run --role designer --model gemma4:latest
#   unitytools studio-execute --task-id <id> --model qwen2.5:14b-instruct
OLLAMA_MODEL=gemma4:latest

# --- Optional dual-agent mode ---------------------------------------------
# Unity/Unreal embedded panels start dual-agent by default. All three
# slots now default to gemma4:latest per the studio's default flip.
# Set any slot to a heavier model if planning quality matters more
# than latency for your project.
USE_DUAL_AGENT=true
DUAL_AGENT_READER=gemma4:latest
DUAL_AGENT_MASTER=gemma4:latest
DUAL_AGENT_WORKER=gemma4:latest

# --- LLM uretim parametreleri ----------------------------------------------
# Anthropic max_tokens (varsayilan 8192). Kompleks gorevlerde 16384'e cikarin.
UNITYTOOLS_MAX_TOKENS=8192

# Sohbet gecmisi: en fazla kac mesaj/turn tutulsun (token sismesini engeller)
UNITYTOOLS_HISTORY_LIMIT=40

# --- Unity Editor Bridge ---------------------------------------------------
UNITY_BRIDGE_PORT=7777
UNITY_BRIDGE_HOST=127.0.0.1
UNITY_RPC_TIMEOUT=180

# --- Unreal Editor Bridge --------------------------------------------------
# UnrealToolsBridge listens on this port inside Unreal Editor.
UNREAL_BRIDGE_PORT=8777
UNREAL_BRIDGE_HOST=127.0.0.1
UNREAL_RPC_TIMEOUT=180
# Optional; empty means auto-detect UE_*/UnrealEditor.exe.
UNREAL_EXECUTABLE=

# --- Blender ---------------------------------------------------------------
# Bos birakirsaniz PATH'ten ve standart kurulum konumlarindan otomatik aranir.
# Windows ornegi: BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
BLENDER_EXECUTABLE=

# --- Unity executable (batch mode icin, opsiyonel) -------------------------
# UNITY_EXECUTABLE=C:\Program Files\Unity\Hub\Editor\6000.0.30f1\Editor\Unity.exe

# --- Logging --------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


