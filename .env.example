# Optional Anthropic API key. Not needed when UNITYTOOLS_PROVIDER=ollama.
ANTHROPIC_API_KEY=

# Cloud model used only when UNITYTOOLS_PROVIDER=anthropic.
UNITYTOOLS_MODEL=claude-sonnet-4-20250514

# LLM provider: ollama or anthropic.
UNITYTOOLS_PROVIDER=ollama

# Ollama local/free provider settings.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Unity Editor TCP listener port.
UNITY_BRIDGE_PORT=7777
UNITY_BRIDGE_HOST=127.0.0.1

# Blender executable path. Leave empty to auto-detect.
# Windows example: C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
BLENDER_EXECUTABLE=

# Optional Unity executable path for batch workflows.
# UNITY_EXECUTABLE=C:\Program Files\Unity\Hub\Editor\6000.4.5f1\Editor\Unity.exe

LOG_LEVEL=INFO
